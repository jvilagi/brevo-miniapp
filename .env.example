# Plantilla sense secrets. El backend admet les variables següents.
# No es carrega automàticament des del checkout.
# Desa els valors reals en un fitxer privat fora del repositori.
# No utilitzis variables VITE_* per a cap dels secrets següents.
# Guia pas a pas: docs/installation.md.
# Plantilla només de claus: deploy/accounts.env.example.

BREVO_ACCOUNT_1_NAME=
BREVO_ACCOUNT_1_API_KEY=
BREVO_ACCOUNT_2_NAME=
BREVO_ACCOUNT_2_API_KEY=

# Hash de la contrasenya de la MiniApp i secret de sessió, no claus de Brevo.
APP_PASSWORD_HASH=
SESSION_SECRET=

# Origen del desenvolupament local. Producció: defineix el teu HTTPS.
PUBLIC_ORIGIN=http://127.0.0.1:5174

# Fus verificat a Brevo: GMT+2 fix. No suposar Europe/Madrid a l'hivern.
BREVO_TIMEZONE=Etc/GMT-2
# Fitxers privats opcionals, camins absoluts fora del checkout.
# BREVO_SECRETS_FILE=/ruta/privada/accounts.env
# AUTH_SECRETS_FILE=/ruta/privada/auth.env
# AUTH_PASSWORD_FILE=/ruta/privada/access/password.json
# ACCOUNT_NAMES_FILE=/ruta/privada/access/account-names.json
# HOST=0.0.0.0 només quan es configuri el desplegament en contenidor.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
