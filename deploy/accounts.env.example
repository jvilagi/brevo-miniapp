# Plantilla buida: una API key REST de cada compte Brevo.
# Copia-la a ~/.config/brevo-miniapp/accounts.env, fora del repositori,
# amb permisos 0600. Introdueix els valors només al fitxer privat.
# No hi posis claus SMTP, contrasenyes ni variables VITE_*.
BREVO_ACCOUNT_1_API_KEY=
BREVO_ACCOUNT_2_API_KEY=
